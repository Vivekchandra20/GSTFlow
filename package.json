{
  "name": "gstflow",
  "version": "0.1.0",
  "description": "Multi-marketplace GST reconciliation SaaS engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev:backend": "tsx watch src/app/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "tsx src/app/server.ts",
    "build": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "test": "vitest run",
    "test:frontend": "npm --prefix frontend run test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck:frontend": "npm --prefix frontend run typecheck"
  },
  "keywords": [
    "gst",
    "reconciliation",
    "amazon-mtr",
    "tax"
  ],
  "author": "GSTFlow Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@prisma/client": "5.22.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.2",
    "csv-parse": "^5.5.6",
    "decimal.js": "^10.4.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "16.15.0-beta.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "16.15.0-beta.19",
    "ioredis-mock": "^8.13.1",
    "pg": "8.23.1",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
